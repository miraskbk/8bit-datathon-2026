# Run python -m tools.setup_local to create a private local key automatically.
API_KEY=replace-with-a-private-jury-key
PIPELINE=visioncore
VLM_BACKEND=mlx
VLM_MODEL=models/Qwen3-VL-8B-Instruct-4bit
MAX_VIDEO_MB=35
MAX_DURATION_SECONDS=180
ANALYSIS_TIMEOUT_SECONDS=270
MAX_PENDING_JOBS=1
JOB_TTL_SECONDS=3600
PRELOAD_MODEL=true
# Linux/NVIDIA: use setup_local --backend transformers instead.
# Pixel limit applies to width * height; default supports up to UHD 4K.
MAX_VIDEO_PIXELS=8294400
# Production: replace with JSON including your public domain and loopback health host.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Only needed for Docker Compose + automatic HTTPS. Replace before deploying.
# DEMO_DOMAIN=review.your-domain.example
